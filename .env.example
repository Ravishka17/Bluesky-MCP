# Bluesky MCP Server - Environment Variables Template
# ===================================================
# SECURITY WARNING: Never commit actual credentials to version control!
# These are template variables - actual values should be provided externally

# Bluesky Service URL (default: https://bsky.social)
BLUESKY_SERVICE_URL=https://bsky.social

# Optional: Public API URL for unauthenticated requests
BLUESKY_PUBLIC_API_URL=https://public.api.bsky.app

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration (optional)
ENABLE_CACHE=false
CACHE_TTL_SECONDS=300

# Server Configuration
PORT=8000
NODE_ENV=production

# ============================================
# OAUTH (Claude custom connector, "Requires sign-in")
# ============================================
# REQUIRED for OAuth. A random string of at least 32 characters.
# This is an ENCRYPTION KEY used to seal authorization codes and tokens.
# It is not a Bluesky credential. Generate one with:
#   openssl rand -base64 48
# Changing it invalidates every OAuth token that was issued before.
OAUTH_SECRET=

# Optional: force the public base URL (no trailing slash).
# Normally detected automatically from the request headers.
PUBLIC_BASE_URL=https://bluesky-mcp.vercel.app

# Optional: extra redirect URIs (comma-separated) accepted for manually typed
# client IDs. Claude's callbacks and localhost URLs are always accepted.
OAUTH_ALLOWED_REDIRECT_URIS=

# Optional: set to "true" to let /mcp answer requests that have no credentials
# (public tools only). Leave "false" so OAuth clients receive a 401 and start
# the sign-in flow.
ALLOW_ANONYMOUS_MCP=false

# ============================================
# CREDENTIAL MANAGEMENT
# ============================================
# IMPORTANT: Bluesky credentials should NEVER be stored in Vercel Environment
# Variables or committed to version control.
#
# The Bluesky app password is provided externally, either through the OAuth
# sign-in page or through request headers:
# - X-BLUESKY-IDENTIFIER: Your Bluesky handle/email
# - X-BLUESKY-PASSWORD: Your app-specific password
#
# For local development, you can use a .env.local file (not committed to git)
# or export them as environment variables before running.
#
# Example for local development:
#   export BLUESKY_IDENTIFIER="your-handle.bsky.social"
#   export BLUESKY_APP_PASSWORD="your-app-password"
# ============================================
